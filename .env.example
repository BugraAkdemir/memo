# Memo Environment Variables
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real secrets.

# Google OAuth credentials (for Google Drive cloud sync).
# Create them at https://console.cloud.google.com/ → APIs & Services → Credentials.
MEMO_GOOGLE_CLIENT_ID=your-google-oauth-client-id
MEMO_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# "gemini-sub" subscription provider (Settings → Developer → Connect Google
# account). NOTHING NEEDS TO BE SET HERE: it ships with gemini-cli's own
# public OAuth client baked in, so there is no Google Cloud project / consent
# screen / key to register — just sign in with a Google account in the
# browser (or already be logged in with the `gemini` CLI). These vars are an
# optional override only.
# MEMO_GOOGLE_GEMINI_CLIENT_ID=
# MEMO_GOOGLE_GEMINI_CLIENT_SECRET=
# Optional: point gemini-sub at a different Code Assist base URL.
# Default: https://cloudcode-pa.googleapis.com/v1internal
# MEMO_GEMINI_SUB_ENDPOINT=

# "claude-sub" subscription provider (Settings → Claude Subscription). NOTHING
# NEEDS TO BE SET HERE either: it ships with Claude Code's own public OAuth
# client, so there is nothing to register — sign in with your Claude account in
# the browser. Better still, if you are already signed in to Claude Code (or
# have run `claude setup-token`) on this machine, Connect picks that up with no
# browser at all. These vars are an optional override only.
# MEMO_CLAUDE_CLIENT_ID=
# Optional: point claude-sub at a different OAuth host (e.g. a staging tenant).
# MEMO_CLAUDE_AUTH_URL=https://claude.ai/oauth/authorize
# MEMO_CLAUDE_TOKEN_URL=https://platform.claude.com/v1/oauth/token
# Optional: force a specific registered redirect_uri. Two are in circulation and
# which one Anthropic has registered has changed before, so by default both are
# offered and the second is a fallback.
# MEMO_CLAUDE_REDIRECT_URI=https://platform.claude.com/oauth/code/callback
# Optional: a long-lived token from `claude setup-token`. Set this and Connect
# never opens a browser.
# MEMO_CLAUDE_TOKEN=
