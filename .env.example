# Memo Environment Variables
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real secrets.

# Google OAuth credentials (for Google Drive cloud sync).
# Create them at https://console.cloud.google.com/ → APIs & Services → Credentials.
MEMO_GOOGLE_CLIENT_ID=your-google-oauth-client-id
MEMO_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# "gemini-sub" subscription provider (Settings → Developer → Connect Google
# account). NOTHING NEEDS TO BE SET HERE: it ships with gemini-cli's own
# public OAuth client baked in, so there is no Google Cloud project / consent
# screen / key to register — just sign in with a Google account in the
# browser (or already be logged in with the `gemini` CLI). These vars are an
# optional override only.
# MEMO_GOOGLE_GEMINI_CLIENT_ID=
# MEMO_GOOGLE_GEMINI_CLIENT_SECRET=
# Optional: point gemini-sub at a different Code Assist base URL.
# Default: https://cloudcode-pa.googleapis.com/v1internal
# MEMO_GEMINI_SUB_ENDPOINT=
