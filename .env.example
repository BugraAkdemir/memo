# Memo Environment Variables
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real secrets.

# Google OAuth credentials (for Google Drive cloud sync).
# Create them at https://console.cloud.google.com/ → APIs & Services → Credentials.
MEMO_GOOGLE_CLIENT_ID=your-google-oauth-client-id
MEMO_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Google OAuth credentials for the "gemini-sub" subscription provider
# (Settings → Developer → Connect Google account). A separate "Desktop app"
# OAuth client from the sync one; the project needs the Code Assist API
# enabled. A built-in client ships in internal/geminisub/oauth.go; set these
# to override it.
MEMO_GOOGLE_GEMINI_CLIENT_ID=your-desktop-oauth-client-id
MEMO_GOOGLE_GEMINI_CLIENT_SECRET=your-desktop-oauth-client-secret
# Optional: point gemini-sub at a different Code Assist base URL (fallback /
# testing). Default: https://cloudcode-pa.googleapis.com/v1internal
# MEMO_GEMINI_SUB_ENDPOINT=
